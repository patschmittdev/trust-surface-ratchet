  [--verify] [--memory] [--globalIdentity] [--pv p] [--dissentMin d] [--dissentFrac f]
  [--adversary flood|suppress|split|spread|floodall] [--N n] [--byz f] [--seed s] [--seeds n]
  [--rounds t] [--M m] [--k k] [--r r] [--amp a] [--eps e] [--noise sd] [--decay d]
  [--window w] [--sweepN a,b,c] [--sweepByz f1,f2,...]`);
  process.exit(0);
}

const base = {
  protocol: args.protocol,
  verify: args.verify,
  memory: args.memory,
  pv: Number(args.pv),
  dissentMin: Number(args.dissentMin),
  dissentFrac: Number(args.dissentFrac),
  globalIdentity: args.globalIdentity,
  adversary: args.adversary,
